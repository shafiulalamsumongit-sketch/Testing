  "item": [
    {
      "name": "TC_CATAPI_IMG_001 - Valid limit=2 mime_types=jpg",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is a JSON array\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(Array.isArray(body)).to.be.true;",
              "});",
              "",
              "pm.test(\"Response contains exactly 2 items (matches limit)\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.length).to.eql(2);",
              "});",
              "",
              "pm.test(\"Each item URL ends with .jpg\", function () {",
              "    const body = pm.response.json();",
              "    body.forEach(function (item) {",
              "        pm.expect(item.url.toLowerCase()).to.match(/\\.jpg$/);",
              "    });",
              "});",
              "",
              "pm.test(\"Each item has required fields: id, url, width, height\", function () {",
              "    const body = pm.response.json();",
              "    body.forEach(function (item) {",
              "        pm.expect(item).to.have.property('id').that.is.a('string').and.is.not.empty;",
              "        pm.expect(item).to.have.property('url').that.is.a('string').and.is.not.empty;",
              "        pm.expect(item).to.have.property('width').that.is.a('number');",
              "        pm.expect(item).to.have.property('height').that.is.a('number');",
              "    });",
              "});",
              "",
              "pm.test(\"Content-Type header is application/json\", function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "",
              "pm.test(\"Response time is within acceptable range (<2000ms)\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/images/search?limit=2&mime_types=jpg",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "images",
            "search"
          ],
          "query": [
            {
              "key": "limit",
              "value": "2"
            },
            {
              "key": "mime_types",
              "value": "jpg"
            }
          ]
        },
        "description": "Positive test: verify 2 jpg images are returned with valid schema."
      },
      "response": []
    },
